# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# Google Gemini API Key
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (defaults to gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Supabase Configuration
# Get your URL & Keys at: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
# Role-based secret key (service_role secret key for backend, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Anon public key (optional fallback)
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_BUCKET=study-materials


